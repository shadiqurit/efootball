NODE_ENV=development
PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
# Strict works for HTTPS frontend/backend subdomains of the same parent domain.
# Use none only for different sites, with NODE_ENV=production and HTTPS.
SESSION_SAME_SITE=strict
# Use 1 only when the hosting provider places exactly one trusted proxy before Node.
TRUST_PROXY=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=efootball
DB_USER=efootball
DB_PASSWORD=
DB_POOL_SIZE=5
# Set these only for admin:create, then remove ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_NAME=Manager
ADMIN_PASSWORD=
