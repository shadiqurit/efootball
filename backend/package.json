{
  "name": "touchline-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:setup": "node scripts/setup-db.js",
    "db:migrate": "node scripts/migrate-db.js",
    "db:import": "node scripts/import-excel-data.js",
    "db:import:legacy": "node scripts/import-players.js",
    "db:import:excel": "node scripts/import-excel-data.js",
    "db:seed-file": "node scripts/export-seed.js",
    "admin:create": "node scripts/create-admin.js",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write src scripts tests app.cjs package.json",
    "format:check": "prettier --check src scripts tests app.cjs package.json"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.15.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
