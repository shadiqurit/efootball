NODE_ENV=production
HOST=127.0.0.1
PORT=3005
APP_ORIGIN=https://__DOMAIN__
SESSION_SAME_SITE=strict
# Exactly one local IIS/ARR proxy forwards to the loopback-only Node listener.
TRUST_PROXY=1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=efootball
DB_USER=touchline
DB_PASSWORD=REPLACE_WITH_YOUR_DATABASE_PASSWORD
DB_POOL_SIZE=5
