{
  "name": "touchline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "install:all": "npm --prefix backend ci && npm --prefix frontend ci",
    "dev": "npm --prefix frontend run dev",
    "dev:api": "npm --prefix backend run dev",
    "demo": "npm --prefix frontend run demo",
    "build": "npm --prefix frontend run build",
    "release:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File deploy/windows/Build-Package.ps1",
    "start": "npm --prefix backend start",
    "db:setup": "npm --prefix backend run db:setup",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:import": "npm --prefix backend run db:import",
    "db:import:excel": "npm --prefix backend run db:import:excel",
    "db:seed-file": "npm --prefix backend run db:seed-file",
    "admin:create": "npm --prefix backend run admin:create",
    "test": "npm --prefix backend test && npm --prefix frontend test",
    "format": "npm --prefix backend run format && npm --prefix frontend run format",
    "format:check": "npm --prefix backend run format:check && npm --prefix frontend run format:check"
  }
}
